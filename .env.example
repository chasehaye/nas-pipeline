# Root (docker-compose) — environment variables (local-dev defaults provided).
# Values below work as-is for local compose; change POSTGRES_PASSWORD before any
# real/exposed use. `.env` is gitignored — never commit real values.
# In production these come from Kubernetes (ConfigMap for non-secret keys,
# Secret for sensitive ones).
#
# Format (docker-compose .env):
#   - plain KEY=value, one per line
#   - no `export ` prefix, no surrounding quotes
#
# Only compose-level values live here; per-service settings live in that
# service's own .env (e.g. bridge/.env).

# --- Postgres ---
POSTGRES_DB=naspipeline
POSTGRES_USER=naspipeline
POSTGRES_PASSWORD=changeme      # sensitive