# filter — files kept OUT of the Docker build context (smaller, faster builds;
# secrets never enter an image layer). The Dockerfile copies only what it needs.

# repo / build meta
.git
.gitignore
.gitattributes
.dockerignore
Dockerfile
*.md

# secrets
.env
.env.*

# local Go build output
bin/
*.exe
*.test
*.out

# CUI: the LADD Industry file must never enter the build context
data/

# logs
*.log
