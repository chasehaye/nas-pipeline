# ladd-admin (server) — environment variables (ALL OPTIONAL).
# Every key has a working default — copy to .env only to OVERRIDE one locally;
# `.env` is gitignored. In production these come from the Kubernetes manifest.
#
# The age PRIVATE key is NOT set here. It is mounted from the ladd-admin-keys
# Secret at LADD_ADMIN_IDENTITY_PATH — never put key material in .env.
#
# Format (godotenv): plain KEY=value, one per line.

# --- HTTP server ---
LADD_ADMIN_ADDR=:8092
LADD_ADMIN_IDENTITY_PATH=/keys/identity.txt   # mounted age identity (private key, decrypts)
LADD_OPERATOR_PUBKEY_PATH=/keys/operator.pub  # operator ed25519 public key (verifies uploads)

# --- target Secret (what this service updates) ---
LADD_SECRET_NAME=ladd
LADD_SECRET_NAMESPACE=nas

# --- validation (fail-closed) ---
LADD_MAX_AGE=216h                             # reject uploads older than this
LADD_MAX_UPLOAD_BYTES=4194304                 # 4 MiB request-body cap
