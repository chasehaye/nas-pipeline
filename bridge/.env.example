# bridge — environment variables.
# Copy to .env and fill in; `.env` is gitignored — never commit real values.
# In production these come from Kubernetes (ConfigMap for non-secret keys,
# Secret for sensitive ones).
#
# Format (Java .properties):
#   - plain KEY=value, one per line
#   - no `export ` prefix, no surrounding quotes
#   - a literal backslash in a value must be doubled: \\
#
# All keys are Solace / SWIM SFDPS credentials — required and sensitive.

# --- Solace / SWIM SFDPS ---
SOLACE_HOST=
SOLACE_VPN=
SOLACE_USERNAME=
SOLACE_PASSWORD=
SOLACE_QUEUE=
SOLACE_CONNECTION_FACTORY=
