    {
      "id": 5,
      "type": "timeseries",
      "title": "Pipeline throughput (per stage)",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(normalizer_envelopes_processed_total[1m]))",
          "legendFormat": "normalizer \u00b7 ingest (raw FIXM)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(normalizer_flights_published_total[1m]))",
          "legendFormat": "normalizer \u00b7 published"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(filter_forwarded_total[1m]))",
          "legendFormat": "filter \u00b7 forwarded"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(cache_writer_stored_total[1m]))",
          "legendFormat": "cache-writer \u00b7 stored (Redis)"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(database_writer_recorded_total[1m]))",
          "legendFormat": "database-writer \u00b7 recorded (Postgres)"
        }
      ]
    },
