# bridge env vars. Copy to .env (gitignored); ISDEV selects the mode.

# Dev mode: replay the committed seed into fixm.raw. No Solace needed.
ISDEV=true

# Live mode: set ISDEV=false and fill in the SWIM/Solace credentials below.
SOLACE_HOST=
SOLACE_VPN=
SOLACE_USERNAME=
SOLACE_PASSWORD=
SOLACE_QUEUE=
SOLACE_CONNECTION_FACTORY=
