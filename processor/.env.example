# Template for processor/.env — copy to `.env` and override as needed.
# `.env` is git-ignored; this .example file is safe to commit (no secrets).
#
# Format (parsed by godotenv):
#   - plain KEY=value, one per line
#   - no `export ` prefix; quotes optional (godotenv strips them)
#   - values already set in the real environment win over this file
#
# Every key has a working default (shown). The processor needs no secrets;
# these only exist to point it at non-local infra or rename topics.

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_RAW=fixm.raw
KAFKA_TOPIC_NORMALIZED=fixm.normalized
KAFKA_GROUP=processor
