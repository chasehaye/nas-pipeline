# database-writer — environment variables (ALL OPTIONAL).
# Every key has a working default; copy to .env only to OVERRIDE one locally.
# In production these come from Kubernetes (ConfigMap / Secret).

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_FILTERED=fixm.filtered
KAFKA_GROUP=database-writer

# --- Postgres / TimescaleDB ---
# Host port 5433 (compose maps 5433->5432; native Postgres owns host 5432).
DATABASE_URL=postgres://naspipeline:changeme@localhost:5433/naspipeline?sslmode=disable

# --- Batching (one transaction / one fsync per batch) ---
DB_WRITER_BATCH_SIZE=500        # flush after this many messages
DB_WRITER_FLUSH_TIMEOUT=1s      # or after this long since the batch's first message
