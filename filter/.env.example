# filter — environment variables (ALL OPTIONAL).
# Every key below has a working default — copy to .env only to OVERRIDE one
# locally; the app runs fine with no .env at all. `.env` is gitignored — never
# commit real values.
# In production these come from Kubernetes (ConfigMap for non-secret keys,
# Secret for sensitive ones).
#
# Format (godotenv):
#   - plain KEY=value, one per line
#   - no `export ` prefix; quotes optional (godotenv strips them)
#   - values already set in the environment win over this file
#
# Every key has a working default (shown); no secrets required. The LADD
# Industry file is CUI and is mounted separately, never set here.

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_NORMALIZED=fixm.normalized
KAFKA_TOPIC_FILTERED=fixm.filtered
KAFKA_GROUP=filter

# --- LADD aircraft-block list ---
LADD_DIR=./data/ladd/active     # directory of dated LADD_Industry_Filter_*.txt files
LADD_MAX_AGE=216h               # staleness limit from publication date (Go units, no "d": 9d = 216h)
LADD_CHECK_EVERY=1h             # how often to re-scan LADD_DIR for a newer file
