# web — environment variables.
# Copy to .env and fill in; `.env` is gitignored — never commit real values.
# In production the value is baked at BUILD time (Vite inlines VITE_* into the
# bundle) — pass it via the Dockerfile build-arg / CI, not at runtime.
#
# Format (Vite):
#   - only vars prefixed with VITE_ are exposed to the client bundle
#   - plain KEY=value, one per line
#
# No secrets here — this ships to the browser. Never put a secret in a VITE_ var.

# --- API ---
VITE_API_BASE=http://localhost:8090
