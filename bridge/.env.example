# Template for bridge/.env — copy this file to `.env` and fill in real values.
# `.env` is git-ignored; this .example file is safe to commit (no secrets).
#
# Format rules (parsed as a Java .properties file):
#   - plain KEY=value, one per line
#   - NO surrounding quotes, NO `export ` prefix
#   - a literal backslash in a value must be doubled: \\

# --- Solace / SWIM SFDPS (all required) ---
SOLACE_HOST=
SOLACE_VPN=
SOLACE_USERNAME=
SOLACE_PASSWORD=
SOLACE_QUEUE=
SOLACE_CONNECTION_FACTORY=