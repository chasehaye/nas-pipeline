# Template for filter/.env — copy to `.env` and override as needed.
# `.env` is git-ignored; this .example file is safe to commit (no secrets).
#
# Format (parsed by godotenv):
#   - plain KEY=value, one per line
#   - no `export ` prefix; quotes optional (godotenv strips them)
#   - values already set in the real environment win over this file
#
# Every key has a working default (shown). No secrets are required; these
# only point the filter at non-local infra, rename topics, or tune the
# LADD list location and reload cadence.

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_NORMALIZED=fixm.normalized
KAFKA_TOPIC_FILTERED=fixm.filtered
KAFKA_GROUP=filter

# --- LADD aircraft-block list ---
# Directory holding dated LADD_Industry_Filter_*.txt files.
LADD_DIR=./data/ladd/active
# Staleness limit from a file's PUBLICATION date. Go duration units only
# (h/m/s — no "d"): 9 days = 216h.
LADD_MAX_AGE=216h
# How often to re-scan LADD_DIR for a newer file.
LADD_CHECK_EVERY=1h
